<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Minha Loja de Roupas{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" xintegrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-light text-dark">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary p-4 rounded-bottom shadow">
            <div class="container d-flex justify-content-between align-items-center">
                <a href="{{ path('app_home') }}" class="navbar-brand fs-4 fw-bold">Minha Loja</a>
                <div>
                    <a href="{{ path('app_home') }}" class="nav-link d-inline-block text-white me-3">Home</a>
                    <a href="/api/produtos" target="_blank" class="nav-link d-inline-block text-white me-3">API Produtos</a>
                    <a href="/ola/Visitante" class="nav-link d-inline-block text-white">Olá Página</a>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1 container mt-4">
        {% block body %}{% endblock %}
    </main>

    <footer class="bg-dark text-white p-4 mt-4 rounded-top shadow text-center">
        <div class="container">
            <p>&copy; {{ "now"|date("Y") }} Minha Loja de Roupas. Todos os direitos reservados.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" xintegrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
