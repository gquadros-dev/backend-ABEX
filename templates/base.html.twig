    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .link {
            color: #99bf5b; /* Sua cor customizada para links */
        }

        /* Estilos customizados para o layout do dashboard */
        .dashboard-grid {
            display: grid;
            gap: 1.5rem; /* Espaçamento entre cards/seções */
        }
        .main-dashboard-title {
            margin-top: 1.5rem;
            margin-bottom: 1.5rem;
            text-align: center;
        }
    </style>
    {{ encore_entry_link_tags('app') }}
</head>
